datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         String         @default("CASHIER") // SUPER_ADMIN, STORE_MANAGER, CASHIER, INVENTORY_MANAGER, ACCOUNTANT
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  sales        Sale[]
  returns      Return[]
  shifts       CashierShift[]
  auditLogs    AuditLog[]
  movements    InventoryMovement[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())

  products    Product[]
}

model Supplier {
  id            String          @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstin         String?
  paymentTerms  String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())

  products       Product[]
  purchaseOrders PurchaseOrder[]
}

model Product {
  id                 String              @id @default(cuid())
  sku                String              @unique
  barcode            String              @unique
  name               String
  description        String?
  categoryId         String
  supplierId         String?
  unit               String              @default("unit")
  purchaseCost       Float
  sellingPrice       Float
  taxRate            Float               @default(0)
  stock              Int                 @default(0)
  minStockThreshold  Int                 @default(5)
  imageUrl           String?
  expiryDate         DateTime?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  category           Category            @relation(fields: [categoryId], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  saleItems          SaleItem[]
  returnItems        ReturnItem[]
  movements          InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
}

model InventoryMovement {
  id            String   @id @default(cuid())
  productId     String
  type          String   // SALE, RETURN, PURCHASE, ADJUSTMENT, DAMAGE
  quantity      Int      // e.g. -2 for sale, +10 for purchase
  previousStock Int
  newStock      Int
  reason        String
  userId        String?
  createdAt     DateTime @default(now())

  product       Product  @relation(fields: [productId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  email         String?
  loyaltyPoints Int      @default(0)
  totalSpent    Float    @default(0)
  orderCount    Int      @default(0)
  createdAt     DateTime @default(now())

  sales         Sale[]
  returns       Return[]
}

model Promotion {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String
  type           String    // PERCENTAGE, FIXED
  value          Float
  minOrderAmount Float     @default(0)
  maxDiscount    Float?
  startsAt       DateTime  @default(now())
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  usageCount     Int       @default(0)
  createdAt      DateTime  @default(now())
}

model Sale {
  id              String      @id @default(cuid())
  invoiceNo       String      @unique
  cashierId       String?
  cashierName     String
  customerId      String?
  subtotal        Float
  couponCode      String?
  couponDiscount  Float       @default(0)
  manualDiscount  Float       @default(0)
  discount        Float       @default(0)
  taxRate         Float       @default(0)
  taxAmount       Float       @default(0)
  finalTotal      Float
  totalUnits      Int
  paymentMethod   String      // CASH, UPI, CARD, SPLIT
  paymentStatus   String      @default("COMPLETED") // COMPLETED, REFUNDED, PARTIALLY_REFUNDED
  amountReceived  Float
  changeReturned  Float       @default(0)
  paymentRef      String?
  splitBreakdown  String?     // JSON string
  createdAt       DateTime    @default(now())

  user            User?       @relation(fields: [cashierId], references: [id])
  customer        Customer?   @relation(fields: [customerId], references: [id])
  items           SaleItem[]
  returns         Return[]
}

model SaleItem {
  id           String       @id @default(cuid())
  saleId       String
  productId    String
  productName  String
  sku          String
  category     String?
  imageUrl     String?
  unitPrice    Float
  purchaseCost Float
  quantity     Int
  subtotal     Float
  discount     Float        @default(0)
  taxRate      Float        @default(0)
  taxAmount    Float        @default(0)
  totalAmount  Float

  sale         Sale         @relation(fields: [saleId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  returnItems  ReturnItem[]
}

model Return {
  id           String       @id @default(cuid())
  returnNo     String       @unique
  saleId       String
  cashierId    String?
  customerId   String?
  refundAmount Float
  paymentMethod String
  reason       String
  createdAt    DateTime     @default(now())

  sale         Sale         @relation(fields: [saleId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  user         User?        @relation(fields: [cashierId], references: [id])
  items        ReturnItem[]
}

model ReturnItem {
  id           String    @id @default(cuid())
  returnId     String
  saleItemId   String?
  productId    String
  productName  String
  quantity     Int
  unitPrice    Float
  refundAmount Float
  condition    String    @default("RESTOCKABLE") // RESTOCKABLE, DAMAGED

  return       Return    @relation(fields: [returnId], references: [id])
  saleItem     SaleItem? @relation(fields: [saleItemId], references: [id])
  product      Product   @relation(fields: [productId], references: [id])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  status      String              @default("DRAFT") // DRAFT, ORDERED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  totalAmount Float
  notes       String?
  createdById String?
  orderedAt   DateTime?
  receivedAt  DateTime?
  createdAt   DateTime            @default(now())

  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  productId        String
  productName      String
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Float
  totalCost        Float

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product          Product       @relation(fields: [productId], references: [id])
}

model CashierShift {
  id           String    @id @default(cuid())
  cashierId    String
  cashierName  String
  openingCash  Float
  closingCash  Float?
  expectedCash Float?
  discrepancy  Float?
  notes        String?
  status       String    @default("OPEN") // OPEN, CLOSED
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  user         User      @relation(fields: [cashierId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("SYSTEM") // LOW_STOCK, OUT_OF_STOCK, EXPIRY, PURCHASE, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
}

model StoreSetting {
  id                       String   @id @default("default")
  storeName                String   @default("FreshCart Supermarket")
  tagline                  String   @default("Super Market Billing System & Inventory")
  address                  String   @default("123 Market Road, Retail Hub, City - 560001")
  phone                    String   @default("+91 98765 43210")
  email                    String   @default("contact@freshcart.com")
  gstin                    String   @default("29ABCDE1234F1Z5")
  fssai                    String   @default("11223344556677")
  currency                 String   @default("INR (₹)")
  defaultTaxRate           Float    @default(0)
  defaultLowStockThreshold Int      @default(5)
  cashierName              String   @default("Cashier-01 (Demo Operator)")
  managerPin               String   @default("1234")
  theme                    String   @default("light")
  receiptFooter            String   @default("Thank you for shopping at FreshCart Supermarket! Please visit again.")
}
